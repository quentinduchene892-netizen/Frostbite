  m_Script: {fileID: 11500000, guid: 0d93b64b7cec8474d80dedddb2760017, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCinematic
  nextScene: LD
  slides:
  - image: {fileID: 2800000, guid: 54a3e1a8bfd31ac44a913d017f7cc0c4, type: 3}
    caption: Pendant douze hivers, il n'y a eu que lui et moi.
    hold: 4.5
  - image: {fileID: 2800000, guid: b7652f35f5ea5b5419e36e798088cfb8, type: 3}
    caption: "La neige \xE9tait son terrain de jeu. Il courait loin, il revenait
      toujours."
    hold: 4.5
  - image: {fileID: 2800000, guid: 16ed104da33b819468c6a6bf35f8c0ff, type: 3}
    caption: "Et chaque soir, il s'endormait contre le po\xEAle."
    hold: 4
  - image: {fileID: 2800000, guid: 6ab2dacf1e1a8f648b948aa8fd2e9ded, type: 3}
    caption: "Cette nuit-l\xE0, c'est le froid qui m'a r\xE9veill\xE9."
    hold: 3.5
  - image: {fileID: 2800000, guid: aa476cf4750654945ad195d4cc82e877, type: 3}
    caption: "Sa couche \xE9tait vide. La maison, grande ouverte."
    hold: 4.5
  - image: {fileID: 2800000, guid: 08854ff066603f6489d32c12a399af7d, type: 3}
    caption: "Ses traces filaient droit vers la for\xEAt. Je suis parti les suivre."
    hold: 5.5
